@startuml

class Usuario {
    -id: Long
    -nome: String
}

class Cliente {
    -rg: String
    -cpf: String
    -profissao: String
    -endereco: Endereco
    -empregadores: List<Empregador>
    -pedidos: List<Pedido>
}

class Agente {
    -nome: String
}

class Banco {
    -nome: String
    +aprovarContratoCredito(): boolean
}

class Endereco {
    -rua: String
    -numero: String
    -bairro: String
    -cidade: String
    -estado: String
    -cep: String
}

class Empregador {
    -nome: String
    -rendimento: Double
}

class Pedido {
    -dataCriacao: LocalDate
    -status: StatusPedido
    -parecer: Parecer
    +estaAvaliado(): boolean
    +cancelar(): void
}

abstract class Contrato {
    -contratante: Cliente
    -automovel: Automovel
    +reservarAutomovel(): void
}

class Locacao {
    -dataInicio: LocalDate
    -dataFim: LocalDate
    +devolucaoAutomovel(): void
}

class Assinatura {
    -valorMensalidade: Double
    -dataFim: LocalDate
    +devolucaoAutomovel(): void
}

class Leasing {
    -contratoCredito: ContratoCredito
}

class ContratoCredito {
    -numero: String
    -aprovado: boolean
}

class Automovel {
    -placa: String
    -ano: Int
    -marca: String
    -modelo: String
    -emUso: boolean
    +setEmUso(emUso: boolean): void
}

enum StatusPedido {
    CRIADO
    AVALIADO
    APROVADO
    RECUSADO
    CANCELADO
}

enum Parecer {
    POSITIVO
    NEGATIVO
}

Usuario <|-- Cliente
Usuario <|-- Agente

Cliente "1" -- "1" Endereco
Cliente "1" -- "0..3" Empregador
Cliente "1" -- "0..*" Pedido

Pedido "1" -- "0..1" Contrato
Pedido "0..1" -- "1" Agente

Contrato <|-- Locacao
Contrato <|-- Assinatura
Contrato <|-- Leasing

Contrato "0..1" -- "1" Automovel

Leasing "1" -- "1" ContratoCredito
Banco "1" -- "0..*" ContratoCredito

Cliente "0..*" -- "0..*" Automovel
Agente "0..*" -- "0..*" Automovel

Pedido --> StatusPedido
Pedido --> Parecer

@enduml